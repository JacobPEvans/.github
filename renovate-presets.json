{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Enterprise Renovate policy for consumers of github>JacobPEvans/.github.",
    "Use weekend-only updates, seven-day stabilization, native auto-merge, and shared custom managers and grouping.",
    "Nix support is enabled by the dedicated Nix preset; security updates are handled by Dependabot."
  ],
  "extends": [
    "local>JacobPEvans/.github:renovate-grouping"
  ],
  "platformAutomerge": true,
  "baseBranchPatterns": [
    "$default"
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "dependencyDashboard": false,
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": [
    "279454174+dryvist-github-actions[bot]@users.noreply.github.com",
    "329540381+jacobs-agent-smith[bot]@users.noreply.github.com"
  ],
  "ignoreDeprecated": true,
  "osvVulnerabilityAlerts": false,
  "pre-commit": {
    "enabled": true,
    "description": "Renovate ships the pre-commit manager DISABLED by default, so every .pre-commit-config.yaml rev in the org was frozen - a manual pre-commit autoupdate was the only thing that ever moved one. Enabled here so hook revs ride the same publisher-agnostic minor/patch auto-merge tier as everything else."
  },
  "ignorePaths": [
    ".github/workflows/*.lock.yml",
    ".github/workflows/agentics-maintenance.yml",
    ".github/aw/**"
  ],
  "minimumReleaseAge": "7 days",
  "timezone": "America/New_York",
  "schedule": [
    "* * * * 0,6"
  ],
  "vulnerabilityAlerts": {
    "enabled": false
  },
  "lockFileMaintenance": {
    "description": "Run lock-file maintenance on weekends and auto-merge after required checks pass. Package managers select versions, so release-age filtering does not apply.",
    "enabled": true,
    "schedule": [
      "* * * * 0,6"
    ],
    "automerge": true,
    "minimumReleaseAge": null,
    "updateNotScheduled": false
  },
  "nix": {
    "description": [
      "The Nix manager is enabled only by the dedicated Nix preset."
    ],
    "enabled": false
  },
  "customManagers": [
    {
      "description": "Track annotated version pins in Nix files; hashes are updated separately.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.nix$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track annotated versions of binaries installed from workflow URLs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track Docker image tags in Ansible role defaults.",
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/",
        "/roles/.+/defaults/main/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "_image:\\s*[\"'](?<depName>[^:\"'\\s]+):(?<currentValue>[^\"'\\s]+)[\"']"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Track annotated version pins in Ansible YAML files.",
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/",
        "/roles/.+/defaults/main/.+\\.ya?ml$/",
        "/roles/.+/vars/.+\\.ya?ml$/",
        "/roles/.+/tasks/.+\\.ya?ml$/",
        "/roles/.+/templates/.+/",
        "/inventory/.+\\.ya?ml$/",
        "/group_vars/.+\\.ya?ml$/",
        "/host_vars/.+\\.ya?ml$/",
        "/playbooks/.+\\.ya?ml$/",
        "/scripts/.+/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w]+:\\s*[\"']?(?<currentValue>[^\"'\\s]{1,39}|[^\"'\\s]{41,})(?:[\"'\\s]|$)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*-\\s*[\"']?[A-Za-z0-9_.\\[\\]\\-]+==(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track the Biome version from each biome.jsonc schema URL.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)biome\\.jsonc$/"
      ],
      "matchStrings": [
        "\"\\$schema\": \"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Track actions/setup-python python-version inputs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "python-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python",
      "versioningTemplate": "python"
    },
    {
      "description": "Track actions/setup-node node-version inputs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "node-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "description": "Track the Renovate version used by the shared config validator.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    },
    {
      "description": "Track exact pip install pins in workflow shell commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "pip3? install[^\\n]*",
        "[\"']?(?<depName>[A-Za-z0-9_.\\-]+)==(?<currentValue>[0-9][^\"'\\s*]*)[\"']?(?:\\s|$)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Track annotated Git-pinned Ansible collections and roles.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)requirements\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)[^\\n]*\\n(?:[^\\n]*\\n)*?\\s*version:\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?"
      ]
    },
    {
      "description": "Track upstream release versions for dependencies pinned to forks or patched builds.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)requirements\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n\\s*#\\s*upstream-latest:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track annotated SHA-pinned Git refs and release-tag comments.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.env([.\\-][^/]*)?$/",
        "/\\.env$/",
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*:\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*#\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+[^\\s\"']*)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*=\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*#\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+[^\\s\"']*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "pep723": {
    "managerFilePatterns": [
      "/\\.py$/"
    ]
  },
  "packageRules": [
    {
      "description": "Skip gh-aw generated files managed by their workflow.",
      "matchFileNames": [
        ".github/workflows/*.lock.yml",
        ".github/workflows/agentics-maintenance.yml",
        ".github/aw/**"
      ],
      "enabled": false
    },
    {
      "description": "Label major updates except dryvist packages with update:major.",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!JacobPEvans/**",
        "!JacobPEvans-*/**",
        "!dryvist/**",
        "!jpe-*/**",
        "!https://github.com/JacobPEvans/**",
        "!https://github.com/dryvist/**"
      ],
      "addLabels": [
        "update:major"
      ]
    },
    {
      "description": "Auto-merge other major updates after 30 days and green checks.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days",
      "automerge": true
    },
    {
      "description": "Auto-merge minor, patch, digest, and pin updates after seven days and green checks.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge first-party updates, including majors, after seven days and green checks.",
      "matchPackageNames": [
        "JacobPEvans/**",
        "JacobPEvans-*/**",
        "dryvist/**",
        "jpe-*/**",
        "https://github.com/JacobPEvans/**",
        "https://github.com/JacobPEvans-*/**",
        "https://github.com/dryvist/**",
        "https://github.com/jpe-*/**"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Pin GitHub Actions refs to SHA digests.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "Auto-merge trusted-org majors after seven days and green checks; dep:review triggers the dependency review.",
      "matchPackageNames": [
        "actions/**",
        "ansible/**",
        "anthropics/**",
        "aquasecurity/**",
        "astral-sh/**",
        "aws-actions/**",
        "aws-ia/**",
        "Azure/**",
        "bitwarden/**",
        "cachix/**",
        "codecov/**",
        "criblio/**",
        "DavidAnson/**",
        "DeterminateSystems/**",
        "docker/**",
        "DopplerHQ/**",
        "dorny/**",
        "edolstra/**",
        "github/**",
        "google/**",
        "google-github-actions/**",
        "googleapis/**",
        "hashicorp/**",
        "hercules-ci/**",
        "huggingface/**",
        "kubernetes/**",
        "kubernetes-sigs/**",
        "lycheeverse/**",
        "microsoft/**",
        "nix-community/**",
        "nix-darwin/**",
        "nix-systems/**",
        "NixOS/**",
        "numtide/**",
        "obra/**",
        "open-telemetry/**",
        "opentofu/**",
        "ossf/**",
        "oven-sh/**",
        "oxalica/**",
        "peter-evans/**",
        "pre-commit/**",
        "pypa/**",
        "python/**",
        "raycast/**",
        "renovatebot/**",
        "semgrep/**",
        "sigstore/**",
        "softprops/**",
        "streetsidesoftware/**",
        "terraform-linters/**",
        "wakatime/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": [
        "dep:review"
      ]
    },
    {
      "description": "Extract v-prefixed GitHub release tags for custom Nix pins.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "extractVersion": "^v(?<version>.+)$"
    },
    {
      "description": "Preserve v prefixes in custom-regex GitHub release pins.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchCurrentValue": "/^v/",
      "extractVersion": "^(?<version>.*)$"
    },
    {
      "description": "Disable GitHub tag lookups for Ansible Galaxy collections.",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchDatasources": [
        "github-tags",
        "git-tags"
      ],
      "enabled": false
    },
    {
      "description": "Allow timestamp-less git refs to use the configured release-age policy.",
      "matchDatasources": [
        "git-refs"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Hold Python below 3.15 in repositories that run Ansible until ansible-core supports it.",
      "matchRepositories": [
        "/(^|/)ansible-/",
        "dryvist/homelab-contracts"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    }
  ],
  "updateNotScheduled": false
}

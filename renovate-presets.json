{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Single Renovate policy master for JacobPEvans and dryvist repositories. It extends no other repository's config; dryvist/.github re-exports these presets as pass-throughs.",
    "Every update opens in one grouped PR per repository on Saturday 00:00-05:59 America/Indiana/Indianapolis time; security updates open at any time.",
    "Seven-day stabilization for minor, patch and digest updates, no hold for first-party packages, 30 days for other majors. Renovate merges directly (platformAutomerge false). Shared custom managers live here; Nix support is enabled by the dedicated Nix preset."
  ],
  "extends": [
    "group:all"
  ],
  "platformAutomerge": false,
  "baseBranchPatterns": [
    "$default"
  ],
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "dependencyDashboard": false,
  "dependencyDashboardLabels": [
    "dependencies"
  ],
  "dependencyDashboardOSVVulnerabilitySummary": "unresolved",
  "prConcurrentLimit": 5,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 0,
  "rebaseWhen": "conflicted",
  "gitIgnoredAuthors": [
    "279454174+dryvist-github-actions[bot]@users.noreply.github.com",
    "329540381+jacobs-agent-smith[bot]@users.noreply.github.com"
  ],
  "ignoreDeprecated": true,
  "osvVulnerabilityAlerts": true,
  "pre-commit": {
    "enabled": true,
    "description": "Renovate ships the pre-commit manager DISABLED by default, so every .pre-commit-config.yaml rev in the org was frozen - a manual pre-commit autoupdate was the only thing that ever moved one. Enabled here so hook revs ride the same publisher-agnostic minor/patch auto-merge tier as everything else."
  },
  "ignorePaths": [
    ".github/workflows/*.lock.yml",
    ".github/workflows/agentics-maintenance.yml",
    ".github/aw/**"
  ],
  "minimumReleaseAge": "7 days",
  "internalChecksFilter": "strict",
  "prCreation": "not-pending",
  "timezone": "America/Indiana/Indianapolis",
  "schedule": [
    "* 0-5 * * 6"
  ],
  "vulnerabilityAlerts": {
    "description": "Security/CVE PRs open at any time with a one-day stabilization hold, then auto-merge after required checks pass.",
    "enabled": true,
    "schedule": [
      "at any time"
    ],
    "labels": [
      "type:security"
    ],
    "minimumReleaseAge": "1 day",
    "automerge": true,
    "rangeStrategy": "bump",
    "vulnerabilityFixStrategy": "highest"
  },
  "lockFileMaintenance": {
    "description": "Lock-file maintenance runs in the Saturday 00:00-05:59 America/Indiana/Indianapolis window and auto-merges after required checks pass. Renovate cannot apply minimumReleaseAge to lock-file maintenance; npm and Terraform lock maintenance are disabled below because their package-manager guard or exact provider pins must stay authoritative. updateNotScheduled:false prevents intervening head refreshes.",
    "enabled": true,
    "schedule": [
      "* 0-5 * * 6"
    ],
    "automerge": true,
    "updateNotScheduled": false
  },
  "nix": {
    "description": [
      "The Nix manager is enabled only by the dedicated Nix preset."
    ],
    "enabled": false
  },
  "customManagers": [
    {
      "description": "Track annotated version pins in Nix files; hashes are updated separately.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.pkr\\.hcl$/",
        "/\\.nix$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n|\\s*[\\w\\-]+\\s*=\\s*\\{[^\\n]*\\n)*\\s*url\\s*=\\s*\"github:[^/\\s\"]+/[^/?\\s\"]+(?:/|\\?ref=)(?<currentValue>v?[0-9][^\"\\s]*)\";"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track annotated versions of binaries installed from workflow URLs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s+\\S+\\s*=\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track Docker image tags, with an optional sha256 digest, in Ansible role defaults: quoted, unquoted or folded values.",
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/",
        "/roles/.+/defaults/main/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "_image:\\s*(?:>-\\s*\\n\\s+)?[\"']?(?<depName>[^:{}\"'\\s]+):(?<currentValue>[^@:{}\"'\\s]+)(?:@(?<currentDigest>sha256:[A-Fa-f0-9]{64}))?[\"']?(?:[ \\t\\r\\n]|$)"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "Track annotated Docker image pins (tag and sha256 digest) in Molecule scenario molecule.yml files, plain or folded image values.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)molecule/[^/]+/molecule\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+image:\\s*(?:>-\\s*\\n\\s+)?[^\\s@]+:(?<currentValue>[^:@\\s]+)@(?<currentDigest>sha256:[A-Fa-f0-9]{64})"
      ],
      "versioningTemplate": "docker"
    },
    {
      "description": "Track annotated version pins in Ansible YAML files, .env.example files and shell (.sh) files.",
      "customType": "regex",
      "managerFilePatterns": [
        "/roles/.+/defaults/main\\.ya?ml$/",
        "/roles/.+/defaults/main/.+\\.ya?ml$/",
        "/roles/.+/vars/.+\\.ya?ml$/",
        "/roles/.+/tasks/.+\\.ya?ml$/",
        "/roles/.+/templates/.+/",
        "/inventory/.+\\.ya?ml$/",
        "/group_vars/.+\\.ya?ml$/",
        "/host_vars/.+\\.ya?ml$/",
        "/playbooks/.+\\.ya?ml$/",
        "/scripts/.+/",
        "/(^|/)\\.env\\.example$/",
        "/\\.sh$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w]+:\\s*[\"']?(?<currentValue>[^\"'\\s]{1,39}|[^\"'\\s]{41,})(?:[\"'\\s]|$)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n[A-Z][A-Z0-9_]*=(?<currentValue>[^\\s#]+)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*-\\s*[\"']?[A-Za-z0-9_.\\[\\]\\-]+==(?<currentValue>[^\"'\\s]+)[\"']?"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track the Biome version from each biome.jsonc schema URL.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)biome\\.jsonc$/"
      ],
      "matchStrings": [
        "\"\\$schema\": \"https://biomejs\\.dev/schemas/(?<currentValue>[^/]+)/schema\\.json\""
      ],
      "depNameTemplate": "@biomejs/biome",
      "datasourceTemplate": "npm"
    },
    {
      "description": "Track actions/setup-python python-version inputs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "python-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+(?:\\.\\d+)?)[\"']?"
      ],
      "datasourceTemplate": "python-version",
      "depNameTemplate": "python",
      "versioningTemplate": "python"
    },
    {
      "description": "Track actions/setup-node node-version inputs.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "node-version:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "datasourceTemplate": "node-version",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "description": "Track the Renovate version used by the shared config validator.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStrings": [
        "RENOVATE_VERSION:\\s*[\"']?(?<currentValue>\\d+\\.\\d+\\.\\d+)[\"']?"
      ],
      "datasourceTemplate": "npm",
      "depNameTemplate": "renovate",
      "versioningTemplate": "npm"
    },
    {
      "description": "Track exact pip install pins in workflow shell commands.",
      "customType": "regex",
      "managerFilePatterns": [
        "/\\.github/workflows/.+\\.ya?ml$/"
      ],
      "matchStringsStrategy": "recursive",
      "matchStrings": [
        "pip3? install[^\\n]*",
        "[\"']?(?<depName>[A-Za-z0-9_.\\-]+)==(?<currentValue>[0-9][^\"'\\s*]*)[\"']?(?:\\s|$)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Track annotated Git-pinned Ansible collections and roles.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)requirements\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+) currentValue=(?<currentValue>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n(?:[^\\n]*\\n)*?\\s*version:\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?"
      ]
    },
    {
      "description": "Track upstream release versions for dependencies pinned to forks or patched builds.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)requirements\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n\\s*#\\s*upstream-latest:\\s*(?<currentValue>[^\\s#]+)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    },
    {
      "description": "Track annotated SHA-pinned Git refs and release-tag comments.",
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.env([.\\-][^/]*)?$/",
        "/\\.env$/",
        "/\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))? currentValue=(?<currentValue>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*:\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))? currentValue=(?<currentValue>\\S+)(?: extractVersion=(?<extractVersion>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*=\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*:\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*#\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+[^\\s\"']*)",
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?[^\\n]*\\n(?:\\s*#[^\\n]*\\n)*\\s*[\\w.\\-]+\\s*=\\s*[\"']?(?<currentDigest>[0-9a-fA-F]{40})[\"']?[^\\n]*#\\s*(?<currentValue>v?\\d+\\.\\d+\\.\\d+[^\\s\"']*)"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver-coerced{{/if}}"
    }
  ],
  "pep723": {
    "managerFilePatterns": [
      "/\\.py$/"
    ]
  },
  "packageRules": [
    {
      "description": "Skip gh-aw generated files managed by their workflow.",
      "matchFileNames": [
        ".github/workflows/*.lock.yml",
        ".github/workflows/agentics-maintenance.yml",
        ".github/aw/**"
      ],
      "enabled": false
    },
    {
      "description": "Label major updates except dryvist packages with update:major.",
      "matchUpdateTypes": [
        "major"
      ],
      "matchPackageNames": [
        "!JacobPEvans/**",
        "!JacobPEvans-*/**",
        "!dryvist/**",
        "!jpe-*/**",
        "!https://github.com/JacobPEvans/**",
        "!https://github.com/dryvist/**"
      ],
      "addLabels": [
        "update:major"
      ]
    },
    {
      "description": "Auto-merge other major updates after 30 days and green checks.",
      "matchUpdateTypes": [
        "major"
      ],
      "minimumReleaseAge": "30 days",
      "automerge": true
    },
    {
      "description": "Auto-merge minor, patch, digest, and pin updates after seven days and green checks.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days"
    },
    {
      "description": "Auto-merge first-party updates, including majors, with no release-age hold once green checks pass.",
      "matchPackageNames": [
        "JacobPEvans/**",
        "JacobPEvans-*/**",
        "dryvist/**",
        "jpe-*/**",
        "https://github.com/JacobPEvans/**",
        "https://github.com/JacobPEvans-*/**",
        "https://github.com/dryvist/**",
        "https://github.com/jpe-*/**"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Pin GitHub Actions refs to SHA digests.",
      "matchManagers": [
        "github-actions"
      ],
      "pinDigests": true
    },
    {
      "description": "JacobPEvans and JacobPEvans-personal reusable workflows ride their floating major tag (@v1) and are not digest-pinned. dryvist/** refs are covered by the next rule.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "JacobPEvans/**",
        "JacobPEvans-personal/**"
      ],
      "pinDigests": false
    },
    {
      "description": "dryvist/** GitHub Actions refs are pinned to a full 40-character commit SHA with the release tag in a trailing comment: uses: dryvist/<repo>/...@<sha> # vX.Y.Z. Renovate moves the SHA and the comment together.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dryvist/**"
      ],
      "pinDigests": true
    },
    {
      "description": "dryvist/** patch updates auto-merge after green CI without a release-age hold.",
      "matchPackageNames": [
        "dryvist/**",
        "https://github.com/dryvist/**"
      ],
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "dryvist/** minor updates auto-merge after green CI without a release-age hold. Major updates in repos with manual automerge are excluded by the last rule.",
      "matchPackageNames": [
        "dryvist/**",
        "https://github.com/dryvist/**"
      ],
      "matchUpdateTypes": [
        "minor"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "dryvist/** digest, pin and pinDigest updates are not auto-merged by Renovate; the bot-PR auto-merge sweep merges them once checks are green. A digest update moves a ref or version comment without a release.",
      "matchPackageNames": [
        "dryvist/**",
        "https://github.com/dryvist/**"
      ],
      "matchUpdateTypes": [
        "digest",
        "pin",
        "pinDigest"
      ],
      "automerge": false,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "dryvist/** major updates auto-merge after green CI. Major updates in repos with manual automerge are excluded by the last rule.",
      "matchPackageNames": [
        "dryvist/**",
        "https://github.com/dryvist/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "0 days"
    },
    {
      "description": "Auto-merge trusted-org majors after seven days and green checks; dep:review triggers the dependency review.",
      "matchPackageNames": [
        "actions/**",
        "ansible/**",
        "anthropics/**",
        "aquasecurity/**",
        "astral-sh/**",
        "aws-actions/**",
        "aws-ia/**",
        "Azure/**",
        "bitwarden/**",
        "cachix/**",
        "codecov/**",
        "criblio/**",
        "DavidAnson/**",
        "DeterminateSystems/**",
        "docker/**",
        "DopplerHQ/**",
        "dorny/**",
        "edolstra/**",
        "github/**",
        "google/**",
        "google-github-actions/**",
        "googleapis/**",
        "hashicorp/**",
        "hercules-ci/**",
        "huggingface/**",
        "kubernetes/**",
        "kubernetes-sigs/**",
        "lycheeverse/**",
        "microsoft/**",
        "nix-community/**",
        "nix-darwin/**",
        "nix-systems/**",
        "NixOS/**",
        "numtide/**",
        "obra/**",
        "open-telemetry/**",
        "opentofu/**",
        "ossf/**",
        "oven-sh/**",
        "oxalica/**",
        "peter-evans/**",
        "pre-commit/**",
        "pypa/**",
        "python/**",
        "raycast/**",
        "renovatebot/**",
        "semgrep/**",
        "sigstore/**",
        "softprops/**",
        "streetsidesoftware/**",
        "terraform-linters/**",
        "wakatime/**"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": true,
      "minimumReleaseAge": "7 days",
      "addLabels": [
        "dep:review"
      ]
    },
    {
      "description": "Strip an optional v prefix from GitHub release tags for custom-regex pins.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "extractVersion": "^v?(?<version>.+)$"
    },
    {
      "description": "Preserve v prefixes in custom-regex GitHub release pins.",
      "matchDatasources": [
        "github-releases"
      ],
      "matchManagers": [
        "custom.regex"
      ],
      "matchCurrentValue": "/^v/",
      "extractVersion": "^(?<version>.*)$"
    },
    {
      "description": "Disable GitHub tag lookups for Ansible Galaxy collections.",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "matchDatasources": [
        "github-tags",
        "git-tags"
      ],
      "enabled": false
    },
    {
      "description": "Allow timestamp-less git refs to use the configured release-age policy.",
      "matchDatasources": [
        "git-refs"
      ],
      "minimumReleaseAgeBehaviour": "timestamp-optional"
    },
    {
      "description": "Hold Python below 3.15 in repositories that run Ansible until ansible-core supports it.",
      "matchRepositories": [
        "/(^|/)ansible-/",
        "dryvist/homelab-contracts"
      ],
      "matchDepNames": [
        "python"
      ],
      "allowedVersions": "<3.15"
    },
    {
      "description": "Exclude LiteLLM 1.107.0 from updates.",
      "matchPackageNames": [
        "litellm",
        "ghcr.io/berriai/litellm",
        "berriai/litellm"
      ],
      "allowedVersions": "!/^1\\.107\\.0$/"
    },
    {
      "description": "Repos whose automerge custom property is manual (tofu-github config/automerge.yml: every ansible-* repo and nix-ai): major updates are never auto-merged there and the org-automerge-manual ruleset requires a person's approval; other update types auto-merge. Last rule so it overrides every automerge setting above.",
      "matchRepositories": [
        "dryvist/ansible-*",
        "dryvist/nix-ai"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "automerge": false
    },
    {
      "description": "Do not run npm lock-file maintenance: Renovate cannot enforce minimumReleaseAge for that update type, so package-manager guardrails must remain authoritative.",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": false
    },
    {
      "description": "Do not run Terraform lock-file maintenance: provider pins and their lock entries must be updated together by ordinary provider updates.",
      "matchManagers": [
        "terraform"
      ],
      "matchUpdateTypes": [
        "lockFileMaintenance"
      ],
      "enabled": false
    }
  ],
  "updateNotScheduled": false
}

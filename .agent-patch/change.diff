-          CI_GATE_ALLOWED_SKIPS: >-
-            flake-lock-fresh,
-            nix-validate, nix-build, markdown-lint, file-size, token-limits,
-            python-security, python-ci, ansible-ci, renovate-annotations,
-            tofu-ci, osv-scan, dependency-review, zizmor, watchdog,
-            repo-tests, workflow-lint
-          CI_GATE_ALLOWED_FAILURES: scope
-        run: node .gh-shared/scripts/ci-gate-aggregate.mts
+          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
+          REPO: ${{ github.repository }}
+          PR_NUMBER: ${{ github.event.pull_request.number }}
+        run: |
+          set -euo pipefail
+          # Read the labels live from the API, never from the event payload,
+          # which a concurrent labelling or a stale trigger event can make
+          # out of date.
+          labelled="$(gh pr view "$PR_NUMBER" --repo "$REPO" --json labels \
+            --jq 'any(.labels[]?; .name == "checks:deferred")')"
+          if [[ "$labelled" == "true" ]]; then
+            echo "pull request #$PR_NUMBER already carries checks:deferred"
+            exit 0
+          fi
+          if ! gh pr edit "$PR_NUMBER" --repo "$REPO" --add-label checks:deferred; then
+            echo "::error::labelling pull request #$PR_NUMBER with checks:deferred failed; the caller must grant the pull-requests: write permission to the gate job"
+            exit 1
+          fi
+          echo "labelled pull request #$PR_NUMBER with checks:deferred"
       # Run after every sibling is terminal, when timestamps are final.
       - name: Job durations + queue-delay summary
         if: ${{ always() }}

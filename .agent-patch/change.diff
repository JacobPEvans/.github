diff --git a/.github/workflows/_post-merge.yml b/.github/workflows/_post-merge.yml
new file mode 100644
index 0000000..4a38b7c
--- /dev/null
+++ b/.github/workflows/_post-merge.yml
@@ -0,0 +1,486 @@
+# Reusable: settle the checks a fast-lane merge deferred.
+#
+# A pull request labelled checks:deferred merged without running its heavy
+# checks (the gate's bot, tiny and land-first lanes defer them). This
+# workflow is the caller for pushes to the default branch and settles the
+# debt on HEAD:
+#
+#   1. The `green` branch marks the newest commit whose deferred work is
+#      verified. When it does not exist yet, it is created at the commit
+#      before the push (github.event.before) and the first run settles from
+#      there.
+#   2. The merged pull requests labelled checks:deferred between green and
+#      HEAD are collected through the API (commits/{sha}/pulls).
+#   3. None -> green is fast-forwarded to HEAD; there is nothing to verify.
+#   4. Otherwise _ci-gate.yml runs the caller's enabled checks on HEAD (a
+#      push event selects the full tier, and the lane classifier can never
+#      take a fast lane without a pull request payload, so every enabled
+#      heavy check runs), and every deferred pull request must carry an
+#      "AI Merge Gate" check run on its head commit whose summary says
+#      VERDICT: MERGE. A VERDICT: DEFERRED summary means the review has not
+#      finished: the verdict is re-read for at most 8 minutes (inside the
+#      job's 10-minute cap), then treated as red. All green -> green is
+#      fast-forwarded to HEAD.
+#   5. Red -> the failure is posted to chat (skipped when the optional
+#      slack_webhook_url secret is empty; this repository uses no
+#      slack-github-action anywhere), a post-merge-red repository_dispatch
+#      with the commit id and the run URL is sent to the calling
+#      repository, and a revert job waits in the revert-delay environment
+#      (the 15-minute wait timer lives on that environment; no runner is
+#      held while it waits). Still red afterwards — green still does not
+#      contain the red commit, so a later verified run cannot be undone —
+#      every deferred pull request is reverted, each revert pull request is
+#      labelled auto-revert and its auto-merge is armed. A VERDICT: CHANGES
+#      verdict skips the wait and runs the same revert steps at once.
+#   6. green only ever moves forward: it is moved with a plain non-forced
+#      ref update of a commit id, which the API rejects when it is not a
+#      fast-forward. A rewritten default branch therefore fails the run
+#      instead of rewinding green.
+#
+# Caller shape (a push to the caller's default branch):
+#
+#   on:
+#     push:
+#       branches: [main]
+#
+#   jobs:
+#     post-merge:
+#       permissions:
+#         contents: write    # green ref moves, post-merge-red dispatches
+#         pull-requests: write
+#         checks: read       # AI Merge Gate verdicts on the head commits
+#         actions: write     # forwarded to _ci-gate.yml's queue watchdog
+#       uses: JacobPEvans/.github/.github/workflows/_post-merge.yml@v1
+#       with:
+#         profile: nix       # the caller's gate stack, forwarded verbatim
+#       secrets:
+#         GH_APP_PRIVATE_KEY: ${{ secrets.GH_APP_PRIVATE_KEY }}
+#         slack_webhook_url: ${{ secrets.SLACK_WEBHOOK_URL }}
+#
+# The App token copies _flake-lock-fresh.yml: minted from
+# vars.GH_APP_CLIENT_ID and secrets.GH_APP_PRIVATE_KEY when the key is set,
+# with github.token as the fallback.
+
+name: _post-merge
+
+on:
+  workflow_call:
+    inputs:
+      filters:
+        description: >-
+          YAML body for dorny/paths-filter, forwarded to _ci-gate.yml. The
+          full event tier a push selects runs every enabled check, so this
+          carries the caller's gate config for parity, not a switch.
+        type: string
+        required: false
+        default: ''
+      profile:
+        description: Preset forwarded to _ci-gate.yml, enabling its matching checks.
+        type: string
+        required: false
+        default: ''
+      nix_build:
+        description: >-
+          Enable the Nix Build check on HEAD (forwarded to _ci-gate.yml; the
+          one heavy tier a profile does not enable by itself).
+        type: boolean
+        required: false
+        default: false
+      runner_label:
+        description: GitHub Actions runner label for _ci-gate.yml's check jobs.
+        type: string
+        required: false
+        default: ubuntu-24.04
+    secrets:
+      GH_APP_PRIVATE_KEY:
+        description: >-
+          Optional private key of the automation App (vars.GH_APP_CLIENT_ID).
+          Empty falls back to github.token, like _flake-lock-fresh.yml.
+        required: false
+      slack_webhook_url:
+        description: >-
+          Optional chat webhook for the red post. Empty (default) skips the
+          post step.
+        required: false
+
+concurrency:
+  group: post-merge-${{ github.ref }}
+  cancel-in-progress: false
+
+jobs:
+  verify:
+    name: Verify Deferred Merges
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: write
+      pull-requests: read
+    env:
+      HAS_APP_KEY: ${{ secrets.GH_APP_PRIVATE_KEY != '' }}
+    outputs:
+      has_deferred: ${{ steps.deferred.outputs.has_deferred }}
+      deferred: ${{ steps.deferred.outputs.deferred }}
+      green_sha: ${{ steps.green.outputs.green }}
+    steps:
+      - name: Mint the App token
+        id: app-token
+        if: env.HAS_APP_KEY == 'true'
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3
+        with:
+          client-id: ${{ vars.GH_APP_CLIENT_ID }}
+          private-key: ${{ secrets.GH_APP_PRIVATE_KEY }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-pull-requests: write
+
+      - name: Seed the green branch when it does not exist
+        id: green
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          BEFORE: ${{ github.event.before }}
+          HEAD_SHA: ${{ github.sha }}
+        run: |
+          set -euo pipefail
+          green="$(gh api "repos/$REPO/git/ref/heads/green" --jq .object.sha 2>/dev/null || true)"
+          if [[ -z "$green" ]]; then
+            seed="$BEFORE"
+            if [[ -z "$seed" || "$seed" == 0000000000000000000000000000000000000000 ]]; then
+              seed="$(gh api "repos/$REPO/commits/$HEAD_SHA" --jq '.parents[0].sha // ""')"
+            fi
+            if [[ -z "$seed" ]]; then
+              seed="$HEAD_SHA"
+            fi
+            gh api -X POST "repos/$REPO/git/refs" -f ref=refs/heads/green -f sha="$seed"
+            green="$seed"
+            echo "seeded green at $seed"
+          fi
+          echo "green=$green" >> "$GITHUB_OUTPUT"
+
+      - name: List the merged pull requests deferred between green and HEAD
+        id: deferred
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          GREEN_SHA: ${{ steps.green.outputs.green }}
+          HEAD_SHA: ${{ github.sha }}
+        run: |
+          set -euo pipefail
+          has_deferred=false
+          deferred='[]'
+          if [[ "$GREEN_SHA" != "$HEAD_SHA" ]]; then
+            compare="$(gh api "repos/$REPO/compare/$GREEN_SHA...$HEAD_SHA")"
+            if [[ "$(jq -r '.ahead_by' <<<"$compare")" -gt "$(jq '.commits | length' <<<"$compare")" ]]; then
+              echo "::error::green is more than 250 commits behind HEAD; the compare API would hide deferred pull requests"
+              exit 1
+            fi
+            ndjson=""
+            for sha in $(jq -r '.commits[].sha' <<<"$compare"); do
+              pulls="$(gh api "repos/$REPO/commits/$sha/pulls?per_page=100" \
+                --jq '.[] | select(.merged_at != null and ([(.labels // [])[].name] | index("checks:deferred"))) | {number: .number, head_sha: .head.sha}')"
+              [[ -z "$pulls" ]] || ndjson+="${pulls}"$'\n'
+            done
+            if [[ -n "$ndjson" ]]; then
+              deferred="$(printf '%s' "$ndjson" | jq -cs 'unique_by(.number)')"
+              has_deferred=true
+            fi
+          fi
+          {
+            echo "has_deferred=$has_deferred"
+            echo "deferred=$deferred"
+          } >> "$GITHUB_OUTPUT"
+          printf 'deferred pull requests: %s\n' "$deferred"
+
+  # Called on the caller's push event, so _ci-gate.yml selects the full test
+  # tier and the lane classifier cannot take a fast lane: every enabled
+  # check runs on HEAD. Its optional secrets are deliberately not forwarded,
+  # which leaves the scope classifier in its fail-safe full tier.
+  gate:
+    name: Post-Merge Gate
+    needs: [verify]
+    if: needs.verify.outputs.has_deferred == 'true'
+    permissions:
+      contents: read
+      pull-requests: read
+      actions: write
+    uses: ./.github/workflows/_ci-gate.yml
+    with:
+      filters: ${{ inputs.filters }}
+      profile: ${{ inputs.profile }}
+      nix_build: ${{ inputs.nix_build }}
+      runner_label: ${{ inputs.runner_label }}
+
+  verdicts:
+    name: Read AI Verdicts
+    needs: [verify]
+    if: needs.verify.outputs.has_deferred == 'true'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      checks: read
+      pull-requests: read
+    env:
+      GH_TOKEN: ${{ github.token }}
+      REPO: ${{ github.repository }}
+      DEFERRED: ${{ needs.verify.outputs.deferred }}
+    outputs:
+      red: ${{ steps.verdicts.outputs.red }}
+      changes: ${{ steps.verdicts.outputs.changes }}
+    steps:
+      - name: 'Require VERDICT: MERGE on every deferred pull request'
+        id: verdicts
+        run: |
+          set -euo pipefail
+          deadline=$((SECONDS + 480))
+          pending=true
+          changes=false
+          while [[ "$pending" == true && "$changes" == false && $SECONDS -lt $deadline ]]; do
+            pending=false
+            changes=false
+            while IFS= read -r pr; do
+              [[ -n "$pr" ]] || continue
+              head_sha="$(jq -r --argjson n "$pr" '.[] | select(.number == $n) | .head_sha' <<<"$DEFERRED")"
+              summary="$(gh api "repos/$REPO/commits/$head_sha/check-runs?per_page=100" \
+                --jq '[.check_runs[] | select(.name == "AI Merge Gate")] | sort_by(.started_at) | last | .output.summary // ""' \
+                || true)"
+              case "$summary" in
+                *"VERDICT: MERGE"*) ;;
+                *"VERDICT: CHANGES"*) changes=true ;;
+                *"VERDICT: DEFERRED"*) pending=true ;;
+                *) pending=true ;;
+              esac
+            done < <(jq -r '.[].number' <<<"$DEFERRED")
+            if [[ "$pending" == false || "$changes" == true || $SECONDS -ge $deadline ]]; then
+              break
+            fi
+            sleep 45
+          done
+          red=false
+          if [[ "$pending" == true && "$changes" == false ]]; then
+            red=true
+          fi
+          {
+            echo "changes=$changes"
+            echo "red=$red"
+          } >> "$GITHUB_OUTPUT"
+
+  settle:
+    name: Settle Green
+    needs: [verify, gate, verdicts]
+    if: ${{ always() && needs.verify.result == 'success' }}
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: write
+    env:
+      HAS_APP_KEY: ${{ secrets.GH_APP_PRIVATE_KEY != '' }}
+    outputs:
+      revert: ${{ steps.decide.outputs.revert }}
+      deferred: ${{ needs.verify.outputs.deferred }}
+      head_sha: ${{ github.sha }}
+    steps:
+      - name: Mint the App token
+        id: app-token
+        if: env.HAS_APP_KEY == 'true'
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3
+        with:
+          client-id: ${{ vars.GH_APP_CLIENT_ID }}
+          private-key: ${{ secrets.GH_APP_PRIVATE_KEY }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-pull-requests: write
+
+      - name: Decide the outcome
+        id: decide
+        env:
+          HAS_DEFERRED: ${{ needs.verify.outputs.has_deferred }}
+          GATE_RESULT: ${{ needs.gate.result }}
+          VERDICTS_RESULT: ${{ needs.verdicts.result }}
+          VERDICTS_RED: ${{ needs.verdicts.outputs.red }}
+          VERDICTS_CHANGES: ${{ needs.verdicts.outputs.changes }}
+        run: |
+          set -euo pipefail
+          revert=''
+          if [[ "$HAS_DEFERRED" == 'true' ]]; then
+            if [[ "$VERDICTS_CHANGES" == 'true' ]]; then
+              revert=now
+            elif [[ "$GATE_RESULT" == success && "$VERDICTS_RESULT" == success && "$VERDICTS_RED" != 'true' ]]; then
+              revert=''
+            else
+              revert=delay
+            fi
+          fi
+          echo "revert=$revert" >> "$GITHUB_OUTPUT"
+
+      - name: Fast-forward green to HEAD
+        if: steps.decide.outputs.revert == ''
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          GREEN_SHA: ${{ needs.verify.outputs.green_sha }}
+          HEAD_SHA: ${{ github.sha }}
+        run: |
+          set -euo pipefail
+          if [[ "$GREEN_SHA" == "$HEAD_SHA" ]]; then
+            echo "green is already at $HEAD_SHA"
+            exit 0
+          fi
+          # force=false makes the API reject the update unless it is a plain
+          # fast-forward, so green can only ever move forward.
+          gh api -X PATCH "repos/$REPO/git/refs/heads/green" -F sha="$HEAD_SHA" -F force=false
+
+      - name: Post the red result to chat
+        if: steps.decide.outputs.revert == 'delay'
+        env:
+          SLACK_WEBHOOK_URL: ${{ secrets.slack_webhook_url }}
+          RED_SHA: ${{ github.sha }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          if [[ -z "$SLACK_WEBHOOK_URL" ]]; then
+            echo 'no slack_webhook_url secret; skipping the chat post'
+            exit 0
+          fi
+          payload="$(jq -rn --arg text "post-merge verification failed for $RED_SHA; the deferred merges will be reverted. $RUN_URL" '{text: $text}')"
+          curl -fsSL --max-time 10 -X POST -H 'Content-Type: application/json' -d "$payload" "$SLACK_WEBHOOK_URL"
+
+      - name: Dispatch the CI-fix reaction
+        if: steps.decide.outputs.revert == 'delay'
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          RED_SHA: ${{ github.sha }}
+          RUN_URL: ${{ github.server_url }}/${{ github.repository }}/actions/runs/${{ github.run_id }}
+        run: |
+          set -euo pipefail
+          gh api "repos/$REPO/dispatches" \
+            -f event_type=post-merge-red \
+            -f client_payload[commit]="$RED_SHA" \
+            -f client_payload[run_url]="$RUN_URL"
+
+  # The wait comes from the revert-delay environment's 15-minute wait timer,
+  # so no runner is held while it elapses. The revert step first re-reads
+  # green: a commit a later run already verified (green contains it) is left
+  # alone. gh pr revert is a pure API call, so no checkout is needed and the
+  # job only asks for the read and pull request scopes it uses.
+  revert:
+    name: Revert Deferred Merges
+    needs: [verify, settle]
+    if: >-
+      always() && needs.verify.result == 'success' &&
+      needs.settle.outputs.revert == 'delay'
+    environment: revert-delay
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      pull-requests: write
+    env:
+      HAS_APP_KEY: ${{ secrets.GH_APP_PRIVATE_KEY != '' }}
+      GH_REPO: ${{ github.repository }}
+    steps:
+      - name: Mint the App token
+        id: app-token
+        if: env.HAS_APP_KEY == 'true'
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3
+        with:
+          client-id: ${{ vars.GH_APP_CLIENT_ID }}
+          private-key: ${{ secrets.GH_APP_PRIVATE_KEY }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-pull-requests: write
+
+      - name: Revert each deferred pull request unless green already contains the commit
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          RED_SHA: ${{ needs.settle.outputs.head_sha }}
+          DEFERRED: ${{ needs.settle.outputs.deferred }}
+        run: |
+          set -euo pipefail
+          green="$(gh api "repos/$REPO/git/ref/heads/green" --jq .object.sha)"
+          status="$(gh api "repos/$REPO/compare/$RED_SHA...$green" --jq .status)"
+          if [[ "$status" == ahead || "$status" == identical ]]; then
+            echo "green already contains $RED_SHA; nothing to revert"
+            exit 0
+          fi
+          failures=0
+          for pr in $(jq -r '.[].number' <<<"$DEFERRED"); do
+            if ! out="$(gh pr revert "$pr" 2>&1)"; then
+              echo "::error::reverting #$pr failed: $out"
+              failures=1
+              continue
+            fi
+            revert_pr="$(printf '%s\n' "$out" | grep -oE '(#[0-9]+|pull/[0-9]+)' | grep -oE '[0-9]+' | tail -1 || true)"
+            if [[ -z "$revert_pr" ]]; then
+              echo "::error::no revert pull request number found for #$pr in: $out"
+              failures=1
+              continue
+            fi
+            gh pr edit "$revert_pr" --add-label auto-revert
+            gh pr merge "$revert_pr" --auto --squash
+            echo "reverted #$pr as #$revert_pr; auto-merge armed"
+          done
+          exit "$failures"
+
+  # A VERDICT: CHANGES review verdict means the review asked for changes
+  # after the merge: the same revert steps as the delayed revert, without
+  # the revert-delay environment.
+  revert-changes:
+    name: Revert Deferred Merges (Changes Verdict)
+    needs: [verify, settle]
+    if: >-
+      always() && needs.verify.result == 'success' &&
+      needs.settle.outputs.revert == 'now'
+    runs-on: ubuntu-24.04
+    timeout-minutes: 10
+    permissions:
+      contents: read
+      pull-requests: write
+    env:
+      HAS_APP_KEY: ${{ secrets.GH_APP_PRIVATE_KEY != '' }}
+      GH_REPO: ${{ github.repository }}
+    steps:
+      - name: Mint the App token
+        id: app-token
+        if: env.HAS_APP_KEY == 'true'
+        uses: actions/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3
+        with:
+          client-id: ${{ vars.GH_APP_CLIENT_ID }}
+          private-key: ${{ secrets.GH_APP_PRIVATE_KEY }}
+          repositories: ${{ github.event.repository.name }}
+          permission-contents: write
+          permission-pull-requests: write
+
+      - name: Revert each deferred pull request unless green already contains the commit
+        env:
+          GH_TOKEN: ${{ steps.app-token.outputs.token || github.token }}
+          REPO: ${{ github.repository }}
+          RED_SHA: ${{ needs.settle.outputs.head_sha }}
+          DEFERRED: ${{ needs.settle.outputs.deferred }}
+        run: |
+          set -euo pipefail
+          green="$(gh api "repos/$REPO/git/ref/heads/green" --jq .object.sha)"
+          status="$(gh api "repos/$REPO/compare/$RED_SHA...$green" --jq .status)"
+          if [[ "$status" == ahead || "$status" == identical ]]; then
+            echo "green already contains $RED_SHA; nothing to revert"
+            exit 0
+          fi
+          failures=0
+          for pr in $(jq -r '.[].number' <<<"$DEFERRED"); do
+            if ! out="$(gh pr revert "$pr" 2>&1)"; then
+              echo "::error::reverting #$pr failed: $out"
+              failures=1
+              continue
+            fi
+            revert_pr="$(printf '%s\n' "$out" | grep -oE '(#[0-9]+|pull/[0-9]+)' | grep -oE '[0-9]+' | tail -1 || true)"
+            if [[ -z "$revert_pr" ]]; then
+              echo "::error::no revert pull request number found for #$pr in: $out"
+              failures=1
+              continue
+            fi
+            gh pr edit "$revert_pr" --add-label auto-revert
+            gh pr merge "$revert_pr" --auto --squash
+            echo "reverted #$pr as #$revert_pr; auto-merge armed"
+          done
+          exit "$failures"
diff --git a/tests/post-merge.test.js b/tests/post-merge.test.js
new file mode 100644
index 0000000..5c044d4
--- /dev/null
+++ b/tests/post-merge.test.js
@@ -0,0 +1,131 @@
+'use strict';
+
+const assert = require('node:assert/strict');
+const { readFileSync } = require('node:fs');
+const test = require('node:test');
+
+const workflow = readFileSync('.github/workflows/_post-merge.yml', 'utf8');
+
+// Job bodies, keyed by job name: the jobs: section is the last top-level
+// key, so every two-space key inside the slice is a job name. A sentinel
+// key terminates the last job's body.
+const jobsText = `${workflow.slice(workflow.indexOf('\njobs:\n'))}\n  end-of-jobs-sentinel:\n`;
+const jobBodies = {};
+const jobPattern = /^  ([a-z][a-z-]*):\n([\s\S]*?)(?=\n  [a-z][a-z-]*:\n)/gm;
+let jobMatch;
+while ((jobMatch = jobPattern.exec(jobsText)) !== null) {
+  if (jobMatch[1] !== 'end-of-jobs-sentinel') {
+    jobBodies[jobMatch[1]] = jobMatch[2];
+  }
+}
+
+const SELF_JOBS = ['verify', 'verdicts', 'settle', 'revert', 'revert-changes'];
+
+test('the workflow is callable only: no trigger of its own', () => {
+  const triggerBlock = workflow.match(/^on:\n((?: {2}[^\n]*\n)+)/m);
+  assert.ok(triggerBlock, 'on: block exists');
+  assert.match(triggerBlock[1], /^ {2}workflow_call:$/m);
+  assert.doesNotMatch(
+    triggerBlock[1],
+    /^ {2}(push|pull_request|pull_request_target|schedule|workflow_dispatch|repository_dispatch):$/m,
+  );
+});
+
+test('runs are serial per ref and never cancelled', () => {
+  const block = workflow.match(/^concurrency:\n  group: (.*)\n  cancel-in-progress: (.*)$/m);
+  assert.ok(block, 'top-level concurrency block exists');
+  assert.equal(block[1], 'post-merge-${{ github.ref }}');
+  assert.equal(block[2], 'false');
+});
+
+test('only the delayed revert job waits in the revert-delay environment', () => {
+  assert.match(jobBodies.revert, /^    environment: revert-delay$/m);
+  assert.match(jobBodies.revert, /needs\.settle\.outputs\.revert == 'delay'/);
+  assert.match(jobBodies['revert-changes'], /needs\.settle\.outputs\.revert == 'now'/);
+  assert.doesNotMatch(jobBodies['revert-changes'], /^    environment:/m);
+  assert.equal((workflow.match(/^    environment:/gm) || []).length, 1, 'no other job declares an environment');
+});
+
+test('green moves forward only: no force push anywhere', () => {
+  for (const forbidden of ['--force', 'force=true', '+refs/', 'git push -f', '"force": true', "'force': true"]) {
+    assert.ok(!workflow.includes(forbidden), `no force-push pattern: ${forbidden}`);
+  }
+  const forward = jobBodies.settle.match(/- name: Fast-forward green to HEAD\n([\s\S]*?)(?=\n      - name: )/);
+  assert.ok(forward, 'fast-forward step exists');
+  assert.match(forward[1], /git\/refs\/heads\/green/);
+  assert.match(forward[1], /-F force=false/);
+});
+
+test('the label names are checks:deferred and auto-revert', () => {
+  assert.match(workflow, /index\("checks:deferred"\)/, 'the listing keeps checks:deferred pull requests');
+  assert.match(jobBodies.revert, /--add-label auto-revert/);
+  assert.match(jobBodies['revert-changes'], /--add-label auto-revert/);
+});
+
+test('every job written here carries timeout-minutes of 10 at most', () => {
+  for (const name of SELF_JOBS) {
+    const timeout = jobBodies[name].match(/^    timeout-minutes: (\d+)$/m);
+    assert.ok(timeout, `job ${name} has timeout-minutes`);
+    assert.ok(Number(timeout[1]) <= 10, `job ${name} timeout is at most 10 minutes`);
+  }
+  assert.doesNotMatch(jobBodies.gate, /^    timeout-minutes:/m, 'the called gate carries its own inner timeouts');
+});
+
+test('a red run posts to chat and dispatches post-merge-red with commit id and run URL', () => {
+  const settle = jobBodies.settle;
+  assert.match(settle, /- name: Post the red result to chat/);
+  assert.match(settle, /- name: Dispatch the CI-fix reaction/);
+  assert.match(settle, /-f event_type=post-merge-red/);
+  assert.match(settle, /client_payload\[commit\]="\$RED_SHA"/);
+  assert.match(settle, /client_payload\[run_url\]="\$RUN_URL"/);
+  assert.match(settle, /no slack_webhook_url secret; skipping the chat post/);
+});
+
+test('the AI Merge Gate verdict is required for every deferred pull request', () => {
+  const verdicts = jobBodies.verdicts;
+  assert.match(verdicts, /select\(\.name == "AI Merge Gate"\)/);
+  for (const verdict of ['VERDICT: MERGE', 'VERDICT: CHANGES', 'VERDICT: DEFERRED']) {
+    assert.ok(verdicts.includes(`"${verdict}"`), `handles ${verdict}`);
+  }
+  assert.match(verdicts, /SECONDS \+ 480/, 're-reads for at most 8 of the allowed 10 minutes');
+});
+
+test('a red deferred merge is reverted, labelled auto-revert and auto-merged', () => {
+  for (const name of ['revert', 'revert-changes']) {
+    const body = jobBodies[name];
+    assert.match(body, /gh pr revert "\$pr"/);
+    assert.match(body, /gh pr merge "\$revert_pr" --auto --squash/);
+    assert.match(body, /green already contains \$RED_SHA/, 'a commit green already contains is never reverted');
+  }
+});
+
+test('both secrets are optional and the App token step copies _flake-lock-fresh.yml', () => {
+  const secretsBlock = workflow.match(/^    secrets:\n((?:      .*\n?)+)/m);
+  assert.ok(secretsBlock, 'workflow_call secrets block exists');
+  assert.match(secretsBlock[1], /^      GH_APP_PRIVATE_KEY:$/m);
+  assert.match(secretsBlock[1], /^      slack_webhook_url:$/m);
+  assert.equal((secretsBlock[1].match(/required: false/g) || []).length, 2);
+  assert.equal(
+    (workflow.match(/actions\/create-github-app-token@64ab729a6294000f5aa4a4bc0b73d1f32bc45510 # v3/g) || []).length,
+    4,
+    'one App token step per privileged job',
+  );
+  assert.match(workflow, /client-id: \$\{\{ vars\.GH_APP_CLIENT_ID \}\}/);
+  assert.match(workflow, /private-key: \$\{\{ secrets\.GH_APP_PRIVATE_KEY \}\}/);
+});
+
+test('the deferred run re-runs the shared gate on HEAD with the caller config', () => {
+  assert.match(jobBodies.gate, /needs: \[verify\]/);
+  assert.match(jobBodies.gate, /uses: \.\/\.github\/workflows\/_ci-gate\.yml/);
+  assert.match(jobBodies.gate, /filters: \$\{\{ inputs\.filters \}\}/);
+  assert.match(jobBodies.gate, /profile: \$\{\{ inputs\.profile \}\}/);
+  assert.match(jobBodies.gate, /nix_build: \$\{\{ inputs\.nix_build \}\}/);
+  assert.match(jobBodies.gate, /runner_label: \$\{\{ inputs\.runner_label \}\}/);
+});
+
+test('green is seeded at the commit before the push when it does not exist', () => {
+  const seed = jobBodies.verify.match(/- name: Seed the green branch when it does not exist\n([\s\S]*?)(?=\n      - name: )/);
+  assert.ok(seed, 'seed step exists');
+  assert.match(seed[1], /BEFORE: \$\{\{ github\.event\.before \}\}/);
+  assert.match(seed[1], /-f ref=refs\/heads\/green -f sha="\$seed"/);
+});

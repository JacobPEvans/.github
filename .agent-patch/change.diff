 jobs:
+  # Scope the run against the last successful deployment. Only the scheduled
+  # train (scope_from_last_deployment) checks out green and queries the
+  # deployments API; with the input false (the default) the job runs one
+  # trivial step and reports a non-empty scope, so window-open keeps today's
+  # always-open behavior. With a SHA base, dorny/paths-filter diffs purely
+  # from local objects and fetches nothing itself — hence fetch-depth 0 —
+  # and the same base and head yield an empty diff, so an already-deployed
+  # green needs no special case.
+  scope:
+    name: Scope against the last successful deployment
+    runs-on: ${{ inputs.runner_label }}
+    timeout-minutes: ${{ github.event_name == 'pull_request' && 5 || 30 }}
+    permissions:
+      contents: read
+      deployments: read
+    outputs:
+      empty: ${{ steps.decide.outputs.empty }}
+      sha: ${{ steps.green.outputs.sha }}
+    steps:
+      - uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7
+        if: inputs.scope_from_last_deployment
+        with:
+          ref: green
+          fetch-depth: 0
+      - name: Resolve the green head sha
+        id: green
+        if: inputs.scope_from_last_deployment
+        run: echo "sha=$(git rev-parse HEAD)" >> "$GITHUB_OUTPUT"
+      - name: Find the newest successful converge deployment
+        id: last
+        if: inputs.scope_from_last_deployment
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+        run: |
+          set -euo pipefail
+          # Newest first; the first deployment whose latest status is success
+          # is the train's last successful deployment. Only the newest 100
+          # are examined; if none of them succeeded (or none exist) the sha
+          # stays empty and decide below plans the whole train.
+          deployments="$(gh api "repos/$REPO/deployments?environment=converge&per_page=100" --jq '.[] | "\(.id) \(.sha)"')"
+          last_sha=""
+          if [ -n "$deployments" ]; then
+            while read -r id dep_sha; do
+              [ -n "$id" ] || continue
+              state="$(gh api "repos/$REPO/deployments/$id/statuses?per_page=1" --jq '.[0].state // ""')"
+              if [ "$state" = "success" ]; then
+                last_sha="$dep_sha"
+                break
+              fi
+            done <<< "$deployments"
+          fi
+          echo "sha=$last_sha" >> "$GITHUB_OUTPUT"
+      - uses: dorny/paths-filter@ceb8a2b8f2d89434be7ff52d3de7ec3738c5cc9d # v4
+        id: filter
+        if: inputs.scope_from_last_deployment && steps.last.outputs.sha != ''
+        with:
+          # Comparing green's head to the recorded deployment commit (the
+          # _ci-gate.yml push pattern with the base pinned to a sha).
+          base: ${{ steps.last.outputs.sha }}
+          filters: ${{ inputs.filters }}
+      - name: Decide whether the scoped diff is empty
+        id: decide
+        env:
+          ENABLED: ${{ inputs.scope_from_last_deployment }}
+          LAST_SHA: ${{ steps.last.outputs.sha }}
+          MATCHED: ${{ steps.filter.outputs.changes }}
+        run: |
+          set -euo pipefail
+          # Unscoped callers and a train with no successful deployment yet
+          # always converge. Otherwise paths-filter's changes output is
+          # exactly "[]" when nothing matched any caller filter.
+          if [ "$ENABLED" != "true" ] || [ -z "$LAST_SHA" ]; then
+            echo "empty=false" >> "$GITHUB_OUTPUT"
+            exit 0
+          fi
+          if [ "$MATCHED" = "[]" ]; then
+            echo "empty=true" >> "$GITHUB_OUTPUT"
+          else
+            echo "empty=false" >> "$GITHUB_OUTPUT"
+          fi
+

diff --git a/tests/ci-gate-gate-job.test.js b/tests/ci-gate-gate-job.test.js
new file mode 100644
index 0000000..8d43abb
--- /dev/null
+++ b/tests/ci-gate-gate-job.test.js
@@ -0,0 +1,142 @@
+import assert from 'node:assert/strict';
+import { execFileSync } from 'node:child_process';
+import { existsSync, readFileSync } from 'node:fs';
+import { fileURLToPath } from 'node:url';
+import test from 'node:test';
+
+const workflowText = readFileSync(
+  new URL('../.github/workflows/_ci-gate.yml', import.meta.url),
+  'utf8',
+);
+
+const workflow = JSON.parse(execFileSync(
+  'python3',
+  ['-c', 'import json, sys, yaml; print(json.dumps(yaml.load(sys.stdin, Loader=yaml.BaseLoader)))'],
+  { input: workflowText, encoding: 'utf8' },
+));
+
+const gate = workflow.jobs.gate;
+const stepByName = (name) => gate.steps.find((step) => step.name === name);
+
+// Folded (`>-`) scalars parse to one string; normalise the whitespace so the
+// pins below do not depend on how the expression is wrapped across lines.
+const flat = (value) => String(value).replace(/\s+/g, ' ').trim();
+
+test('the gate aggregates with re-actors/alls-green pinned to the v1.3.0 release commit', () => {
+  const aggregate = stepByName('Aggregate results');
+  assert.ok(aggregate, 'an Aggregate results step exists');
+  assert.match(
+    workflowText,
+    /uses: re-actors\/alls-green@[0-9a-f]{40} # v1\.3\.0$/m,
+    'the action is pinned to a full commit id with a version comment',
+  );
+  assert.equal(aggregate.id, 'aggregate');
+  assert.equal(aggregate.with.jobs, '${{ toJSON(needs) }}');
+  assert.equal(aggregate.with['allowed-failures'], 'scope');
+});
+
+// The jobs that only the lane gates (heavy jobs) must fail a skipped run of
+// theirs on a merge_group entry of a non-legacy repository; every other
+// conditional job keeps its configured skip, and legacy keeps the exact set
+// the deleted aggregate script allowed.
+test('allowed-skips bars the mapped heavy jobs only on non-legacy merge_group entries', () => {
+  const aggregate = stepByName('Aggregate results');
+  const skips = flat(aggregate.with['allowed-skips']);
+  assert.match(
+    skips,
+    /^\$\{\{ needs\.lane\.outputs\.tier != 'legacy' && github\.event_name == 'merge_group' &&/,
+    'one inline expression reads the lane tier and the event',
+  );
+  // The expression's quoted literals are its two short operands ('legacy',
+  // 'merge_group') and the two comma-separated skip lists; keep the lists.
+  const skipLists = [...skips.matchAll(/'([^']*)'/g)]
+    .map((match) => match[1])
+    .filter((literal) => literal.includes(','));
+  assert.equal(skipLists.length, 2, 'the expression picks between two skip lists');
+  const [mergeQueueSkips, legacySkips] = skipLists.map(
+    (list) => list.split(',').map((name) => name.trim()),
+  );
+  assert.ok(!mergeQueueSkips.includes('nix-build'), 'the mapped heavy job may not skip on merge_group');
+  const conditionalJobs = [
+    'flake-lock-fresh',
+    'nix-validate',
+    'markdown-lint',
+    'file-size',
+    'token-limits',
+    'python-security',
+    'python-ci',
+    'ansible-ci',
+    'renovate-annotations',
+    'tofu-ci',
+    'osv-scan',
+    'dependency-review',
+    'zizmor',
+    'watchdog',
+    'repo-tests',
+    'workflow-lint',
+  ];
+  assert.deepEqual(mergeQueueSkips, conditionalJobs, 'every other conditional job may still skip');
+  assert.deepEqual(
+    [...legacySkips].sort(),
+    [...conditionalJobs, 'nix-build'].sort(),
+    'legacy keeps the exact skip set the aggregate script allowed',
+  );
+  for (const alwaysRequired of ['changes', 'uses-resolve', 'scope']) {
+    assert.ok(!legacySkips.includes(alwaysRequired), `${alwaysRequired} is never skippable`);
+    assert.ok(!mergeQueueSkips.includes(alwaysRequired), `${alwaysRequired} is never skippable`);
+  }
+});
+
+test('the shared aggregate script and its test are deleted while the run report stays', () => {
+  assert.equal(existsSync(new URL('../scripts/ci-gate-aggregate.mts', import.meta.url)), false);
+  assert.equal(existsSync(new URL('../tests/ci-gate-aggregate.test.mts', import.meta.url)), false);
+  assert.doesNotMatch(workflowText, /ci-gate-aggregate/);
+  const checkout = stepByName('Sparse-checkout gate scripts from this repo');
+  assert.match(checkout.with['sparse-checkout'], /scripts\/ci-gate-run-report\.sh/);
+  assert.ok(stepByName('Job durations + queue-delay summary'), 'the run-report step stays');
+});
+
+test('the label step follows aggregation and only fast same-repo non-sandbox pull requests get it', () => {
+  const label = stepByName('Label deferred checks on fast-lane pull requests');
+  assert.ok(label, 'a label step exists');
+  const names = gate.steps.map((step) => step.name);
+  assert.ok(names.indexOf('Aggregate results') < names.indexOf(label.name), 'it runs after the aggregate step');
+  const condition = flat(label.if);
+  for (const clause of [
+    "steps.aggregate.conclusion == 'success'",
+    "needs.lane.outputs.lane == 'tiny'",
+    "needs.lane.outputs.lane == 'land-first'",
+    "github.event_name == 'pull_request'",
+    'github.event.pull_request.head.repo.full_name == github.repository',
+    "github.event.pull_request.user.login != 'jacobs-agent-smith[bot]'",
+    "!startsWith(github.head_ref, 'agent/')",
+    "needs.lane.outputs.lane != 'guarded'",
+  ]) {
+    assert.ok(condition.includes(clause), `the label condition pins: ${clause}`);
+  }
+});
+
+test('the label step reads the labels live and fails loudly naming the missing permission', () => {
+  const label = stepByName('Label deferred checks on fast-lane pull requests');
+  assert.match(label.run, /gh pr view "\$PR_NUMBER" --repo "\$REPO" --json labels/);
+  assert.match(label.run, /--add-label checks:deferred/);
+  assert.match(label.run, /pull-requests: write/);
+  assert.equal(
+    label.env.GH_TOKEN,
+    '${{ secrets.GITHUB_TOKEN }}',
+    'the step uses the token the gate job already has',
+  );
+});
+
+test('the gate keeps its required shape and never declares the label write itself', () => {
+  assert.equal(gate.name, 'Merge Gate');
+  assert.equal(gate.if, '${{ always() }}');
+  assert.equal(gate.permissions.actions, 'read');
+  assert.equal(gate.permissions.contents, 'read');
+  assert.equal(gate.permissions['pull-requests'], 'read');
+  assert.doesNotMatch(
+    workflowText,
+    /^ {6}pull-requests: write$/m,
+    'the write scope must come from the caller, per the permissions invariant',
+  );
+});

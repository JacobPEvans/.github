+      # `pull-requests: write`, which a called workflow can never grant
+      # itself (PERMISSIONS INVARIANT): within the standard grant the API
+      # refuses the edit and this step fails loudly naming the missing
+      # permission — a caller that wants the label adds
+      # `pull-requests: write` to its own gate job grant.
+      - name: Label deferred checks on fast-lane pull requests
+        if: >-
+          ${{ steps.aggregate.conclusion == 'success' &&
+          (needs.lane.outputs.lane == 'tiny' || needs.lane.outputs.lane == 'land-first') &&
+          github.event_name == 'pull_request' &&
+          github.event.pull_request.head.repo.full_name == github.repository &&
+          github.event.pull_request.user.login != 'jacobs-agent-smith[bot]' &&

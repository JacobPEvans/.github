@@ -258,7 +253,7 @@ jobs:
           max_attempts: 3
           retry_wait_seconds: 30
           timeout_minutes: 1
-          command: ansible-galaxy collection install -r requirements.yml --force
+          command: ansible-galaxy collection install -r requirements.yml
       # Roles install to ~/.ansible/roles, outside the checkout, so ansible-lint
       # never lints vendored Galaxy role code. Without -p, ansible-galaxy writes
       # to the first roles_path in ansible.cfg (roles/), inside the linted tree.
@@ -269,7 +264,7 @@ jobs:
           max_attempts: 3
           retry_wait_seconds: 30
           timeout_minutes: 1
-          command: ansible-galaxy role install -r requirements.yml --force -p "$HOME/.ansible/roles"
+          command: ansible-galaxy role install -r requirements.yml -p "$HOME/.ansible/roles"
       # Runs on every hit or miss: ansible.cfg's roles_path would otherwise
       # hide ~/.ansible/roles. Repo roles/ stays first in the search path,
       # then the repo's own ansible.cfg roles_path (if any), then Galaxy roles.
diff --git a/.github/workflows/_osv-scan.yml b/.github/workflows/_osv-scan.yml
index f76d6d9..269963b 100644
--- a/.github/workflows/_osv-scan.yml
+++ b/.github/workflows/_osv-scan.yml
@@ -56,11 +56,21 @@ jobs:
           fetch-depth: 0
           persist-credentials: false
 
+      # The key pins the scanner release that the download step installs, so a
+      # version bump downloads fresh instead of restoring a stale binary.
+      - name: Cache osv-scanner
+        id: osv-cache
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6
+        with:
+          path: ~/.cache/osv-scanner
+          key: osv-${{ runner.os }}-${{ runner.arch }}-v2.7.1
+
       - name: Download osv-scanner
         id: osv-download
         uses: nick-fields/retry@ad984534de44a9489a53aefd81eb77f87c70dc60 # v4.0.0
         env:
           GH_TOKEN: ${{ github.token }}
+          CACHE_HIT: ${{ steps.osv-cache.outputs.cache-hit }}
         with:
           max_attempts: 3
           retry_wait_seconds: 30
@@ -80,16 +90,20 @@ jobs:
               *) echo "::error::unsupported arch: $(uname -m)"; exit 1 ;;
             esac
             asset="osv-scanner_${os}_${arch}"
-            base="https://github.com/google/osv-scanner/releases/download/${OSV_SCANNER_VERSION}"
-            if command -v gh >/dev/null 2>&1; then
-              gh release download "$OSV_SCANNER_VERSION" --repo google/osv-scanner \
-                --pattern "$asset" --pattern osv-scanner_SHA256SUMS --dir "$RUNNER_TEMP" --clobber
-            else
-              unset GH_TOKEN
-              curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 20 \
-                -o "${RUNNER_TEMP}/${asset}" "${base}/${asset}"
-              curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 20 \
-                -o "${RUNNER_TEMP}/osv-scanner_SHA256SUMS" "${base}/osv-scanner_SHA256SUMS"
+            dir="${HOME}/.cache/osv-scanner"
+            mkdir -p "${dir}"
+            if [ "${CACHE_HIT}" != "true" ]; then
+              base="https://github.com/google/osv-scanner/releases/download/${OSV_SCANNER_VERSION}"
+              if command -v gh >/dev/null 2>&1; then
+                gh release download "$OSV_SCANNER_VERSION" --repo google/osv-scanner \
+                  --pattern "$asset" --pattern osv-scanner_SHA256SUMS --dir "$dir" --clobber
+              else
+                unset GH_TOKEN
+                curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 20 \
+                  -o "${dir}/${asset}" "${base}/${asset}"
+                curl -fsSL --retry 5 --retry-all-errors --retry-delay 10 --connect-timeout 20 \
+                  -o "${dir}/osv-scanner_SHA256SUMS" "${base}/osv-scanner_SHA256SUMS"
+              fi
             fi
             echo "asset=${asset}" >> "$GITHUB_OUTPUT"
 
@@ -98,14 +112,14 @@ jobs:
           asset: ${{ steps.osv-download.outputs.asset }}
         run: |
           set -euo pipefail
-          cd "${RUNNER_TEMP}"
+          cd "${HOME}/.cache/osv-scanner"
           if command -v sha256sum >/dev/null; then
             grep " ${asset}\$" osv-scanner_SHA256SUMS | sha256sum -c -
           else
             grep " ${asset}\$" osv-scanner_SHA256SUMS | shasum -a 256 -c -
           fi
           chmod +x "${asset}"
-          echo "OSV_BIN=${RUNNER_TEMP}/${asset}" >> "${GITHUB_ENV}"
+          echo "OSV_BIN=${HOME}/.cache/osv-scanner/${asset}" >> "${GITHUB_ENV}"
 
       - name: Scan
         env:

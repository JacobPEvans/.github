 name: _promotion-pr
 
 on:
   workflow_call:
+    inputs:
+      full_suite_workflow:
+        description: The caller's full-suite workflow filename, dispatched on green.
+        required: false
+        type: string
+        default: ''
+      ntfy_topic:
+        description: The ntfy topic receiving the promotion result.
+        required: false
+        type: string

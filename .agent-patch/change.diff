+  record-deployment:
+    name: Record the converge deployment
+    needs: [scope, window-open, trigger]
+    if: always() && needs.window-open.result == 'success' && inputs.scope_from_last_deployment
+    runs-on: ${{ inputs.runner_label }}
+    timeout-minutes: ${{ github.event_name == 'pull_request' && 5 || 30 }}
+    permissions:
+      deployments: write
+    steps:
+      - name: Create the deployment and post its status
+        env:
+          GH_TOKEN: ${{ github.token }}
+          REPO: ${{ github.repository }}
+          GREEN_SHA: ${{ needs.scope.outputs.sha }}
+          TRIGGER_RESULT: ${{ needs.trigger.result }}
+        run: |
+          set -euo pipefail
+          body="$(jq -n --arg ref "$GREEN_SHA" --arg desc "converge trigger ${TRIGGER_RESULT}" \
+            '{ref: $ref, environment: "converge", auto_merge: false, required_contexts: [], description: $desc}')"
+          deployment_id="$(gh api "repos/$REPO/deployments" --input - <<< "$body" --jq '.id')"
+          if [ -z "$deployment_id" ] || [ "$deployment_id" = "null" ]; then
+            echo "::error::deployment creation returned no id"
+            exit 1
+          fi
+          if [ "$TRIGGER_RESULT" = "success" ]; then
+            state=success
+          else
+            state=failure
+          fi
+          gh api "repos/$REPO/deployments/$deployment_id/statuses" \
+            -f state="$state" -f description="converge trigger ${TRIGGER_RESULT}"
+

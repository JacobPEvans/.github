       - name: Aggregate results
+        id: aggregate
+        uses: re-actors/alls-green@b5b5b37504aa4183270bd3d855c52a67f212be35 # v1.3.0
+        with:
+          jobs: ${{ toJSON(needs) }}
+          # One inline expression: every conditional job may skip, except the
+          # lane-gated heavy jobs (nix-build) on a merge_group entry of a
+          # non-legacy repository — there the queue requires them to run, so a
+          # skipped mapped heavy job fails the gate. Legacy keeps the exact
+          # skip set the previous aggregate script allowed. A job in
+          # allowed-skips is still a failure when it fails or is cancelled.
+          allowed-skips: >-
+            ${{ needs.lane.outputs.tier != 'legacy' && github.event_name == 'merge_group' && 'flake-lock-fresh, nix-validate, markdown-lint, file-size, token-limits, python-security, python-ci, ansible-ci, renovate-annotations, tofu-ci, osv-scan, dependency-review, zizmor, watchdog, repo-tests, workflow-lint' || 'flake-lock-fresh, nix-validate, nix-build, markdown-lint, file-size, token-limits, python-security, python-ci, ansible-ci, renovate-annotations, tofu-ci, osv-scan, dependency-review, zizmor, watchdog, repo-tests, workflow-lint' }}
+          allowed-failures: scope
+      # Tiny and land-first pull requests defer the heavy checks to the
+      # post-merge workflow; mark them so post-merge knows to verify them.
+      # Never label guarded, fork or sandbox-author pull requests (the
+      # sandbox identity literals mirror _lane.yml's sandbox_logins default

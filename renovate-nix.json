{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Opt-in Renovate preset for Nix repositories.",
    "Renovate is the only flake.lock writer; the old workflow and dispatch fan-out are being deleted."
  ],
  "extends": [
    "local>JacobPEvans/.github"
  ],
  "gomod": {
    "enabled": true
  },
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "updateNotScheduled": false,
    "groupName": "Nix lock file maintenance"
  },
  "packageRules": [
    {
      "description": "Raise the Go minimum-version directive in a dedicated, review-required PR; Renovate does not bump this directive by default.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "golang"
      ],
      "rangeStrategy": "bump",
      "groupName": "Go toolchain",
      "minimumReleaseAge": null,
      "automerge": false
    },
    {
      "description": "Keep exact Go toolchain directive updates with the Go toolchain PR.",
      "matchManagers": [
        "gomod"
      ],
      "matchDepNames": [
        "go"
      ],
      "matchDepTypes": [
        "toolchain"
      ],
      "groupName": "Go toolchain",
      "minimumReleaseAge": null,
      "automerge": false
    }
  ]
}

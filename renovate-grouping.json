{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": [
    "Shared dependency grouping for enterprise Renovate consumers.",
    "Groups related updates to reduce review noise. Consumers extend renovate-presets instead."
  ],
  "packageRules": [
    {
      "description": "Group .nix custom-regex version pins into one non-major update per repository.",
      "matchManagers": [
        "custom.regex"
      ],
      "matchFileNames": [
        "**/*.nix"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "nix version pins",
      "automerge": true
    },
    {
      "description": "Group OpenTofu and Terraform providers and modules.",
      "matchManagers": [
        "terraform"
      ],
      "groupName": "OpenTofu and Terraform"
    },
    {
      "description": "Group Ansible Galaxy collections.",
      "matchManagers": [
        "ansible-galaxy"
      ],
      "groupName": "Ansible collections"
    },
    {
      "description": "Group OpenTelemetry packages.",
      "matchPackageNames": [
        "@opentelemetry/**",
        "opentelemetry-**"
      ],
      "groupName": "OpenTelemetry"
    },
    {
      "description": "Group TypeScript type definitions; minor and patch updates follow shared auto-merge policy.",
      "matchPackageNames": [
        "@types/**"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "TypeScript types",
      "automerge": true
    },
    {
      "description": "Group ESLint and TypeScript packages.",
      "matchPackageNames": [
        "eslint",
        "eslint-**",
        "@eslint/**",
        "@typescript-eslint/**",
        "typescript-eslint",
        "typescript"
      ],
      "groupName": "ESLint & TypeScript"
    },
    {
      "description": "Group pytest and pytest plugins.",
      "matchDatasources": [
        "pypi"
      ],
      "matchPackageNames": [
        "pytest",
        "pytest-**"
      ],
      "groupName": "pytest"
    },
    {
      "description": "Group AWS SDK packages.",
      "matchPackageNames": [
        "aws-sdk",
        "@aws-sdk/**",
        "boto3",
        "botocore",
        "s3transfer"
      ],
      "groupName": "AWS SDK"
    },
    {
      "description": "Group Hugging Face ecosystem packages.",
      "matchPackageNames": [
        "transformers",
        "tokenizers",
        "datasets",
        "accelerate",
        "huggingface-hub",
        "safetensors",
        "evaluate"
      ],
      "groupName": "HuggingFace"
    },
    {
      "description": "Group selected first-party workflow updates per repository.",
      "matchManagers": [
        "github-actions"
      ],
      "matchPackageNames": [
        "dryvist/.github",
        "dryvist/ai-workflows"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "first-party workflows"
    }
  ]
}
